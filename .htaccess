RewriteEngine On

# Set default page
DirectoryIndex index_kindicore.html

# Ensure HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Remove .html extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Custom rewrites for specific versions
RewriteRule ^version-uno/?$ index2.html [L]
RewriteRule ^version-dos/?$ index3.html [L]
RewriteRule ^version-tres/?$ index4.html [L]
RewriteRule ^version-cuatro/?$ index5.html [L]

# Optional: Redirect old .html requests to new format (if desired)
# RewriteCond %{THE_REQUEST} \s/index2\.html\s [NC]
# RewriteRule ^index2\.html$ /version-uno [R=301,L]
# (Repeat for others if strict redirection is needed)

# ============================================================
# PERFORMANCE OPTIMIZATIONS
# ============================================================

# Enable GZIP Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache-Control Headers (1 year for static assets)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Additional Cache headers
<IfModule mod_headers.c>
    <FilesMatch "\.(webp|png|jpg|jpeg|gif|ico)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
</IfModule>
